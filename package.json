{
  "name": "dsh-auto-collapse",
  "version": "0.2.0",
  "description": "DSH Web 工作段折叠：保留原生一级，将正文之间的思考、工具、上下文合为一个二级，展开后显示原生三级。",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a179-sanae/dsh-auto-collapse.git"
  },
  "homepage": "https://github.com/a179-sanae/dsh-auto-collapse#readme",
  "bugs": {
    "url": "https://github.com/a179-sanae/dsh-auto-collapse/issues"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "deploy": "node deploy.mjs",
    "package": "node deploy.mjs",
    "test": "node test/run-all.mjs",
    "test:unit": "node test/run-unit.mjs",
    "test:browser": "playwright test",
    "preview": "node test/server.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "check": "npm run typecheck && npm test",
    "prepack": "node build.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets/screenshot.png"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "client-plugin",
    "ui",
    "collapse",
    "auto-collapse",
    "chat"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.25.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
